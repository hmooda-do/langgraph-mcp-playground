# Same variables MARS injects. Any OpenAI-compatible endpoint works (DO Inference, OpenAI, vLLM, Ollama...).
HARNESS_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
HARNESS_INFERENCE_MODEL=anthropic-claude-4.5-sonnet
HARNESS_INFERENCE_API_KEY=

# Alternative for local-only runs (used only when HARNESS_INFERENCE_BASE_URL is unset):
# LLM_PROVIDER=anthropic          # or openai
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
